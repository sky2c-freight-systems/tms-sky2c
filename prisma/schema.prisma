// Vhaul4u TMS — Domestic Warehouse module — Prisma schema (MongoDB)
//
// MongoDB notes (deviations from a relational design):
// - No native autoincrement: every model's primary key is a Mongo ObjectId string.
//   Human-readable business keys (Client.clientId, Shipment.fileNumber, Quote.quoteNumber)
//   are separate unique string/int fields generated by the shared numbering services
//   in src/lib/numbering — see Counter model below.
// - No Decimal type on the Mongo connector: money is stored as integer cents (Int) and
//   converted at the app boundary via src/lib/money.ts (decimal.js). This avoids both the
//   legacy "money stored as string" bug AND float rounding error.
// - Cross-collection "soft" references (e.g. a shipment's shipperId pointing at Client) are
//   plain ObjectId-string scalar fields, not Prisma @relation — Mongo has no FK enforcement,
//   and a real @relation for six distinct Client roles (shipper/consignee/carrier/notify/
//   soldTo/shipTo) would force six inverse array fields onto Client for no benefit. True
//   parent-child ownership (Shipment -> CargoContainer -> CargoItem, Shipment -> ArInvoice,
//   Quote -> QuoteCargoItem) uses real @relation so cascade deletes work.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (macOS/Windows). "debian-openssl-3.0.x" is pinned
  // explicitly for Docker: node:20-bookworm-slim has no `openssl` CLI, so Prisma's
  // auto-detection at `generate` time can't correctly identify Debian 12's OpenSSL 3.0
  // and silently falls back to a stale 1.1.x guess — causing a QueryEngine-not-found
  // crash at container runtime rather than at build time.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  displayName  String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Shared numbering (client IDs, file numbers, quote numbers)
// ---------------------------------------------------------------------------

// One atomically-incremented counter per numbering "scope" (e.g. "client:Imaan",
// "file:6060", "quote"). Seeded from the highest existing value on first use, then
// incremented via findOneAndUpdate($inc) so concurrent requests never collide —
// the legacy app scanned for "max existing + 1" on every call with no locking,
// which is exactly the race the Counter model closes.
model Counter {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value Int
}

// ---------------------------------------------------------------------------
// Client — universal party/company master
// ---------------------------------------------------------------------------

model Client {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  clientId        String  @unique // business key, e.g. "Imaan1"
  name            String
  street          String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  zipCode         String?
  country         String?
  isNonUS         Boolean @default(false)
  telephone       String?
  fax             String?
  emailAddress    String?
  accountingEmailAddress String? // billing-specific contact email; synced to the QBO Customer's invoice email instead of emailAddress when set (see ensureCustomerInQBO)
  contact         String?
  contactLastName String?
  printableAddress String? // computed/cached full-address string used on documents
  isActive        Boolean @default(true)
  clientType      String? // free-form category key, resolved against LookupValue(category: "CLIENT_TYPE")

  // Role flags — a client can be MULTIPLE roles simultaneously
  isShipper   Boolean @default(false)
  isConsignee Boolean @default(false)
  isCarrier   Boolean @default(false)
  isNotify    Boolean @default(false)
  isSoldTo    Boolean @default(false)
  isShipTo    Boolean @default(false)
  isCustomer  Boolean @default(false) // AR ("Account") — always set when resolved for the Account role (fixes legacy UseAsCustomer gap)
  isVendor    Boolean @default(false) // AP

  // AR terms
  creditTermsDays    Int?
  creditLimitCents   Int?
  arDefaultTermsDays Int?
  arCreditLimitCents Int?

  // QuickBooks Online mirror (nullable — only populated once synced)
  qboCustomerId  String?
  qboSyncToken   String?
  qboDisplayName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerAccounts CustomerAccount[] // customer-portal logins linked to this Account (see CustomerAccount)

  @@index([isShipper])
  @@index([isConsignee])
  @@index([isCarrier])
  @@index([isNotify])
  @@index([isSoldTo])
  @@index([isShipTo])
  @@index([isCustomer])
  @@index([isVendor])
  @@index([isActive])
}

// Generic lookup collection: ClientType, ContainerType, PieceType, ChargeCode, Currency, etc.
model LookupValue {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  category  String // e.g. "CLIENT_TYPE", "CONTAINER_TYPE", "PIECE_TYPE", "CHARGE_CODE", "CURRENCY"
  value     String // stored key
  label     String // display label
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@unique([category, value])
  @@index([category])
}

// Port/place-of-receipt/place-of-delivery/origin/destination autocomplete master
model Location {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  code      String? // e.g. UN/LOCODE if available
  name      String
  city      String?
  state     String?
  country   String?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Domestic Warehouse Shipment — the core entity
// ---------------------------------------------------------------------------

// Mirrors the Zoho Desk ticket status list exactly (see src/lib/zohoStatusMap.ts for the
// name <-> Zoho label mapping used by the two-way status sync) — every value here must
// have a corresponding Zoho Desk status, and vice versa.
enum ShipmentStatus {
  OPEN
  SCHEDULED
  INTRANSIT
  PICKED_UP
  ON_HOLD
  DELIVERED
  ON_HAND
  ESCALATED
  QUOTE_SENT
  CANCELLED
  CLOSED
}

enum DomesticType {
  TRUCK
  TRUCK_TEAM
  RAIL
  MOTOR_RAIL
  DOMESTIC_AIR
  PICKUP
  RETURN
  OTHER
}

enum IncoTerms {
  CFR
  CIF
  CIP
  CPT
  DAP
  DAT
  DDP
  EXW
  FAS
  FCA
  FOB
}

// The 9 Residential/Warehouse/Terminal pickup x delivery combinations
enum TypeOfService {
  RESIDENTIAL_TO_RESIDENTIAL
  RESIDENTIAL_TO_WAREHOUSE
  RESIDENTIAL_TO_TERMINAL
  WAREHOUSE_TO_RESIDENTIAL
  WAREHOUSE_TO_WAREHOUSE
  WAREHOUSE_TO_TERMINAL
  TERMINAL_TO_RESIDENTIAL
  TERMINAL_TO_WAREHOUSE
  TERMINAL_TO_TERMINAL
}

enum PaymentMethod {
  PREPAID
  COLLECT
  DIRECT
}

enum BillableStatus {
  NOT_APPLICABLE
  IN_PROGRESS
  POSTED
  CANCELLED
  DELETED
}

model DomesticWarehouseShipment {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  fileNumber  String         @unique // `${divisionId}${busLine}${10000+n}` — see src/lib/numbering
  divisionId  Int?
  busLine     Int? // business line code, e.g. 60 = Domestic
  username    String? // creator, defaulted from logged-in user
  status      ShipmentStatus @default(SCHEDULED)
  domesticType DomesticType

  // Parent/child shipments, mirroring Zoho Desk parent/child tickets: an Air Ops ticket
  // becomes the parent shipment, and each child ticket raised from it (Dispatch, Booking,
  // other departments) becomes a child shipment under it. parentId is a plain scalar like
  // the Client references below. parentZohoTicketId is kept separately because a child
  // ticket's webhook can arrive before the parent's shipment exists — parentId is filled
  // in once it does (see linkShipmentFamily in src/lib/zohoShipmentSync.ts).
  parentId           String? @db.ObjectId
  zohoTicketId       String?
  parentZohoTicketId String?
  zohoDepartmentId   String?
  zohoLayoutName     String? // e.g. "Via Warehouse" — picks the form layout; labels child rows in the list
  // Zoho layout fields with no column of their own, keyed by Zoho API name (cf_*) — see
  // src/lib/shipmentLayoutFields.ts. Fields that do have a column are stored there instead.
  zohoFields         Json?

  accountId     String? @db.ObjectId // Client (role=isCustomer)
  shipperId     String? @db.ObjectId // Client (role=isShipper)
  consigneeId   String? @db.ObjectId // Client (role=isConsignee)
  notifyPartyId String? @db.ObjectId // Client (role=isNotify)
  soldToId      String? @db.ObjectId // Client (role=isSoldTo)
  shipToId      String? @db.ObjectId // Client (role=isShipTo)
  carrierId     String? @db.ObjectId // Client (role=isCarrier)

  placeOfReceipt  String?
  origin          String?
  destination     String?
  country         String?
  placeOfDelivery String?
  incoTerms       IncoTerms?

  proNumber      String?
  bolNumber      String? // Bill of Lading number, distinct from fileNumber — sourced from Zoho "BOL Number" custom field
  typeOfService  TypeOfService?
  otherReference String?
  paymentMethod  PaymentMethod?

  transitStartAt DateTime?
  transitEndAt   DateTime?
  shipAt         DateTime?
  cutoffAt       DateTime?
  etaAt          DateTime?
  atdAt          DateTime?

  cargoDescription String?
  insurance        String?
  insuranceValueCents Int?
  codFeeCents         Int?
  dryRun              String? // mirrors Zoho's cf_multiple_quotes custom field (multiline quote history, one amount per line) — parsed into ArInvoiceLineItem rows, see src/lib/billing.ts
  totalChargesCents   Int?
  serviceLevel        String?

  // Zoho Desk ticket layout fields with no existing Shipment equivalent — see
  // src/lib/shipmentZohoSections.ts for their sections, types and Zoho API names.
  // Dispatch Instructions
  shipperStatus     String? // cf_shipper_1 (Known / Yet to Confirm / Unknown)
  quoteBasis        String?
  quotedBy          String?
  palletsDimensions String?
  grossWeight       Float?
  volumetricWeight  Float?
  chargeableWeight  Float?
  stackableTurnable String[] // multiselect
  serviceType       String? // Door to Port / Door to Door — distinct from typeOfService
  // Pickup Instructions
  contactDetails     String?
  locationType       String?
  dockHours          String?
  soNumber           String?
  preferredPickupAt  DateTime?
  pickupInstructions String?
  // Dispatch Operations
  dispatchRoute              String?
  warehouseLocation          String?
  carrierPicklist            String? // Zoho "Carrier-Name" picklist; the Carrier client is carrierId
  pickupRefNumber            String?
  estimatedTruckingCostCents Int?
  pickupScheduleAt           DateTime?
  etaForPickupAt             DateTime?
  etaAtWarehouseAt           DateTime?
  onHandAt                   DateTime?
  onHandDetails              String?

  billableStatus BillableStatus @default(NOT_APPLICABLE) // rollup of arInvoices, recomputed on every invoice status change
  isActive       Boolean        @default(true)
  createdBy      String?        @db.ObjectId
  createdAt      DateTime       @default(now())
  updatedBy      String?        @db.ObjectId
  updatedAt      DateTime       @updatedAt

  cargoContainers CargoContainer[]
  arInvoices      ArInvoice[]
  deliveryOrders  DeliveryOrder[]
  trackingEvents  ShipmentTrackingEvent[]
  generatedDocuments GeneratedDocument[]

  @@index([status])
  @@index([divisionId, busLine])
  @@index([parentId])
  @@index([zohoTicketId])
  @@index([parentZohoTicketId])
  @@index([accountId])
  @@index([shipperId])
  @@index([consigneeId])
  @@index([carrierId])
}

/// Source of a tracking event, so the timeline can distinguish an automatic status sync
/// from something an operator did by hand.
enum TrackingEventSource {
  SYSTEM // shipment created, or another automatic transition
  ZOHO // arrived via a Zoho Desk ticket webhook
  USER // an operator changed the status in this app
}

/// Append-only status history behind the public tracking page. The shipment row only
/// ever holds the *current* status; without this there is no way to show when a shipment
/// reached each milestone, and a timeline inferred from shipAt/etaAt would be inventing
/// events that never happened. Rows are never updated or deleted — a correction is a new
/// event, exactly like a carrier scan history.
model ShipmentTrackingEvent {
  id         String                    @id @default(auto()) @map("_id") @db.ObjectId
  shipmentId String                    @db.ObjectId
  shipment   DomesticWarehouseShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  /// Denormalized so the tracking page can look up a whole timeline by the number a
  /// customer actually types, without a join back through the shipment.
  fileNumber String
  status     ShipmentStatus
  /// Free-text detail shown under the milestone ("Picked up from ...").
  note       String?
  /// Where the event happened, when known — the "PHARR, TX" line in a carrier timeline.
  location   String?
  source     TrackingEventSource @default(SYSTEM)
  occurredAt DateTime            @default(now())
  createdAt  DateTime            @default(now())

  @@index([shipmentId])
  @@index([fileNumber])
  @@index([occurredAt])
}

model CargoContainer {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  shipmentId      String  @db.ObjectId
  shipment        DomesticWarehouseShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  containerNumber String?
  containerType   String?
  seal1           String?
  seal2           String?
  seal3           String?
  tareWeightLbs   Float?
  tareWeightKgs   Float?
  grossWeightLbs  Float?
  grossWeightKgs  Float?
  vgmWeight       Float?

  items CargoItem[]

  @@index([shipmentId])
}

model CargoItem {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  containerId      String  @db.ObjectId
  container        CargoContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)
  description      String?
  numberOfPieces   Int?
  pieceType        String?
  grossWeightLbs   Float?
  grossWeightKgs   Float?
  grossSizeCft     Float?
  grossSizeCbm     Float?
  declaredValueCents Int?

  // Legacy repurposed this table for vehicle transport — kept as an optional extension
  isVehicle    Boolean @default(false)
  vehicleMake  String?
  vehicleModel String?
  vehicleTitle String?
  vehicleState String?

  @@index([containerId])
}

// Simple pickup/delivery scheduling entity
model DeliveryOrder {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  shipmentId        String   @db.ObjectId
  shipment          DomesticWarehouseShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  scheduledDate     DateTime?
  scheduledWindow   String?
  driverName        String?
  truckNumber       String?
  contactPhone      String?
  notes             String?
  status            String   @default("SCHEDULED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shipmentId])
}

// ---------------------------------------------------------------------------
// Domestic Warehouse Quote — independent pre-shipment quoting entity
// ---------------------------------------------------------------------------

model DomesticWarehouseQuote {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  quoteNumber Int      @unique // 600000 + n, see src/lib/numbering

  customerId    String? @db.ObjectId // Client
  contactName   String?
  contactEmail  String?
  contactPhone  String?

  pickupLocation      String?
  dischargeLocation   String?
  finalDestination    String?
  incoTerms           IncoTerms?
  incoTermsLocation   String?

  effectiveDate  DateTime?
  expirationDate DateTime?
  quotedBy       String?
  salesRep       String?

  carrierId    String? @db.ObjectId // Client
  voyageVessel String?

  paymentTerms String?
  transitTime  String?

  // Accessorial flags
  isHazardous              Boolean @default(false)
  isHighValue              Boolean @default(false)
  isOverweight             Boolean @default(false)
  isOversize               Boolean @default(false)
  isBonded                 Boolean @default(false)
  isPerishable             Boolean @default(false)
  needsExtraMan            Boolean @default(false)
  needsTempControl         Boolean @default(false)
  insidePickup             Boolean @default(false)
  insideDelivery           Boolean @default(false)
  liftgatePickup           Boolean @default(false)
  liftgateDelivery         Boolean @default(false)
  residentialPickup        Boolean @default(false)
  residentialDelivery      Boolean @default(false)
  appointmentAtPickup      Boolean @default(false)
  appointmentAtDelivery    Boolean @default(false)

  quotedAmountCents Int?
  status            String @default("DRAFT") // DRAFT | SENT | ACCEPTED | EXPIRED | CONVERTED
  convertedToFileNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cargoItems QuoteCargoItem[]

  @@index([customerId])
  @@index([status])
}

model QuoteCargoItem {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  quoteId        String  @db.ObjectId
  quote          DomesticWarehouseQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description    String?
  numberOfPieces Int?
  pieceType      String?
  grossWeightLbs Float?
  grossSizeCft   Float?
  declaredValueCents Int?

  @@index([quoteId])
}

// ---------------------------------------------------------------------------
// AR Invoicing
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  NOT_APPLICABLE
  IN_PROGRESS
  POSTED
  CANCELLED
  DELETED
}

model ArInvoice {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  shipmentId String? @db.ObjectId // nullable: an invoice can outlive a reversed/adjusted shipment reference
  shipment   DomesticWarehouseShipment? @relation(fields: [shipmentId], references: [id])
  fileNumber String

  invoiceNo          String?
  customerId         String  @db.ObjectId // Client
  chargeCode         String?
  divisionId         Int?
  currencyCode       String?
  exchangeRate       Float?
  prepaidOrCollect   String?
  totalChargeCents   Int
  invoiceDescription String?
  blPrintDescription String?
  status             InvoiceStatus @default(NOT_APPLICABLE)
  invoiceDate        DateTime?
  dueDate            DateTime?
  terms              String?

  isAdjustment   Boolean @default(false) // real flag — legacy detected this via InvoiceNo.Contains("ADJ")
  adjustmentOfId String? @db.ObjectId // ArInvoice, if isAdjustment
  reversalOfId   String? @db.ObjectId // ArInvoice, if this is a reversal (legacy suffixed InvoiceNo with "R")

  qboInvoiceId    String?
  qboSyncToken    String?
  qboLastSyncedAt DateTime?

  lineItems ArInvoiceLineItem[] // parsed from shipment.dryRun + the quote-amount total — see src/lib/billing.ts

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
  @@index([fileNumber])
  @@index([customerId])
  @@index([status])
}

/**
 * One priced line on an ArInvoice — introduced for the Dry Run (Zoho cf_multiple_quotes)
 * flow: each non-empty line of the shipment's dryRun field becomes one row here (amount
 * parsed from that line), plus a final row for the invoice's own quote-amount total. Real
 * relation with cascade delete per this schema's true-ownership convention (see header
 * comment). Manually-created invoices simply have none of these — callers must treat an
 * empty lineItems array as "use totalChargeCents directly", not as an error.
 */
model ArInvoiceLineItem {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId   String    @db.ObjectId
  invoice     ArInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String?
  amountCents Int
  sortOrder   Int // preserves dryRun line order, with the final quote-amount row always last

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// Charge-code -> QBO Item mapping, replacing the legacy GetActiveItemId "pick any active item" workaround
model ChargeCodeQboItemMap {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  chargeCode  String  @unique
  qboItemId   String
  qboItemName String?
  isActive    Boolean @default(true)
}

// ---------------------------------------------------------------------------
// QuickBooks Online OAuth token persistence
// ---------------------------------------------------------------------------

model QboConnection {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  realmId                String   @unique // QBO company ID
  accessToken            String
  refreshToken           String
  accessTokenExpiresAt   DateTime
  refreshTokenExpiresAt  DateTime
  environment            String   @default("sandbox") // "sandbox" | "production"
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Generated documents & app settings — see src/lib/pickupBol.ts
// ---------------------------------------------------------------------------

enum GeneratedDocumentSource {
  MANUAL // an operator pressed "Generate BOL"
  AUTO // created by the auto-generate setting on a Zoho ticket create/update
}

/// A PDF this app generated and keeps itself (not a Zoho ticket attachment). Rows are
/// never updated: regenerating creates a new row, so earlier versions stay downloadable.
model GeneratedDocument {
  id         String                    @id @default(auto()) @map("_id") @db.ObjectId
  shipmentId String                    @db.ObjectId
  shipment   DomesticWarehouseShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  fileNumber String
  docType    String // "pickup-bol"
  fileName   String
  pdf        Bytes
  /// Hash of the data the document was rendered from — auto-generation skips a new
  /// version when nothing on the document changed.
  dataHash   String
  source     GeneratedDocumentSource
  createdBy  String?                   @db.ObjectId
  createdAt  DateTime                  @default(now())

  @@index([shipmentId, docType, createdAt])
}

/// App-wide key/value settings toggled from the UI (e.g. "autoPickupBol").
model AppSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     Json
  updatedBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Zoho Desk integration audit trail
// ---------------------------------------------------------------------------

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

model ZohoSync {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  zohoTicketId     String     @unique
  zohoTicketNumber String?
  fileNumber       String? // set once the shipment is created
  ticketSubject    String?
  ticketStatus     String?
  clientName       String?
  origin           String?
  destination      String?
  carrier          String?
  contactEmail     String?
  contactPhone     String?
  rawPayload       String? // JSON-stringified raw webhook payload, for audit/debugging
  syncStatus       SyncStatus @default(PENDING)
  errorMessage     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([fileNumber])
  @@index([syncStatus])
}

/// One AfterShip tracking (keyed by its normalized tracking number = the shipment's Pro
/// Number) and what was last written to its Zoho ticket, so repeat webhooks only touch
/// Zoho when something changed — see src/lib/aftershipZohoSync.ts.
model AftershipTracking {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  trackingNumber String    @unique
  shipmentId     String?   @db.ObjectId
  zohoTicketId   String?
  lastTag        String? // AfterShip status last posted as a private comment
  lastPickupAt   DateTime?
  lastEtaAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Customer portal (OTP-based login, no password) — see src/lib/otp.ts,
// src/lib/customerSession.ts, src/app/customer/*, src/app/api/customer/*
// ---------------------------------------------------------------------------

/**
 * A customer-portal login, distinct from the internal-staff `User` model — no password;
 * every login sends a fresh OTP (see OtpChallenge). Created only once a registering
 * email/phone is matched against an existing Client with isCustomer=true (auto-match by
 * contact info, never creates a new Client) — see /api/customer/register/verify-otp.
 * A single Client (Account) can have multiple CustomerAccount logins (e.g. several
 * contacts at the same company).
 */
model CustomerAccount {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String?  @unique // required in practice today — OTP delivery is email-only until an SMS provider is wired up
  phone     String?  @unique // stored/matchable, but cannot itself receive an OTP yet
  clientId  String   @db.ObjectId
  client    Client   @relation(fields: [clientId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

/**
 * A single OTP code (hashed, never stored plaintext) for either the register or login
 * flow. `contact` is the normalized email (lowercased) or phone the code was sent to —
 * looked up again at verify time using the same normalization. Expired/consumed/
 * too-many-attempts challenges are simply left behind (not actively purged); they carry
 * no PII beyond the contact string already visible elsewhere.
 */
model OtpChallenge {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  contact    String
  purpose    String // "REGISTER" | "LOGIN"
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([contact, purpose])
}
