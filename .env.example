# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.
 
# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
 
DATABASE_URL=""
 
# QuickBooks Online (Intuit developer app credentials)
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT=""
QBO_REDIRECT_URI=""
 
# Session/auth
SESSION_SECRET=""
 
# Zoho webhook shared secret (checked on incoming webhook requests)
ZOHO_WEBHOOK_SECRET=""
 
# Zoho Desk API (outbound — our app calling INTO Zoho to push the generated file
# number back onto the originating ticket). Self Client app, region: .in
ZOHO_DESK_CLIENT_ID=""
ZOHO_DESK_CLIENT_SECRET=""
ZOHO_DESK_REFRESH_TOKEN=""
ZOHO_DESK_ORG_ID=""
# Portal name in Zoho Desk URLs — used to deep-link a ticket from the shipments list.
ZOHO_DESK_PORTAL_NAME=""
ZOHO_DESK_ACCOUNTS_DOMAIN=""
ZOHO_DESK_API_DOMAIN=""
# API name of the "Reference Number" custom field on the Zoho Desk ticket layout.
ZOHO_DESK_REFERENCE_NUMBER_FIELD=""
# Writes the generated fileNumber back onto the ticket's Reference Number field.
# This DB (tms-qa) is the one actually processing live Zoho Desk tickets, so this must
# be "true" for Reference Number push-back to work. Was left "false" (its default-safe
# value) after the gate was introduced in d1a069c on 2026-08-07 — that silently disabled
# the push-back with no error, which is why the field stopped populating from that date
# even though shipment/file-number generation kept working fine.
ZOHO_DESK_PUSH_ENABLED=""
# Parent/child shipments from Zoho parent/child tickets (Sky2C Air Ops flow). "true" or
# "false"; leave empty to enable only for Sky2C's Zoho org (60028198741) — Vhaul4u stays flat.
ZOHO_PARENT_CHILD_ENABLED=""
# Posts a real, customer-visible "reply all" into the originating ticket when a file/order
# number is generated for a SKY2C ECOM account (src/lib/zohoOrderNotification.ts). Keep
# "false" until verified against a real test ticket — this DB processes live tickets.
ZOHO_DESK_REPLY_ENABLED=""
# The current Self Client OAuth grant lacks the scope for /api/v1/mailReplyAddress (live
# 403 SCOPE_MISMATCH) and every ticket routes through the single "Dispatch Ops" department,
# so this override is used instead of a live lookup. Verified: active, verified sender.
ZOHO_DESK_REPLY_FROM_ADDRESS=""
 
# Email (for the "Email document" action on print screens) — SMTP fallback, used only
# when the Microsoft Graph vars below aren't configured.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
 
# Microsoft Graph API mail sending (preferred over SMTP — this Microsoft 365 tenant
# has SMTP AUTH disabled). App registration "tms", client-credentials (app-only) flow,
# with the Mail.Send Application permission granted admin consent.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
# Mailbox the app sends as — must be a real mailbox in this tenant.
GRAPH_SENDER_MAILBOX=""
 
APP_BASE_URL=""
 

# Order confirmation emails (src/lib/orderConfirmationEmail.ts)
ORDER_CONFIRMATION_EMAIL_ENABLED=""

# Freight Desk Assistant embedded at /freight-desk (src/app/freight-desk/page.tsx)
SKY2C_FREIGHT_DESK_URL=""
